{
  "name": "noutieren",
  "version": "1.2.0",
  "description": "Noutieren — a private, local-first Firefox sidebar extension for formatted notes organized into color-labeled tabs.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-icons.mjs",
    "prebuild": "node scripts/generate-icons.mjs",
    "build": "npm run build:app && npm run build:background && node scripts/verify-build.mjs",
    "build:app": "vite build",
    "build:background": "vite build --config vite.background.config.ts",
    "dev:chrome": "vite --config chrome_version/vite.config.ts",
    "build:chrome": "npm run icons && npm run build:chrome:app && npm run build:chrome:sw && node scripts/verify-build.mjs --target=chrome",
    "build:chrome:app": "vite build --config chrome_version/vite.config.ts",
    "build:chrome:sw": "vite build --config chrome_version/vite.serviceworker.config.ts",
    "package:chrome": "npm run build:chrome && node scripts/package-chrome.mjs",
    "verify:chrome": "npm run build:chrome && node scripts/verify-chrome.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "webext:lint": "web-ext lint --source-dir dist --self-hosted",
    "firefox": "npm run build && web-ext run --source-dir dist",
    "package": "npm run build && web-ext build --source-dir dist --overwrite-dest --ignore-files \"**/*.map\"",
    "check": "npm run typecheck && npm run lint && npm run test:run && npm run build && npm run webext:lint && npm run build:chrome",
    "images:chrome": "npm run build:chrome && node scripts/capture-store-images.mjs",
    "icon:store": "node scripts/generate-store-icon.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.29.0",
    "@tiptap/extension-list": "^3.29.0",
    "@tiptap/extensions": "^3.29.0",
    "@tiptap/pm": "^3.29.0",
    "@tiptap/react": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "web-ext": "^10.5.0"
  }
}
